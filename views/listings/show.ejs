<% layout("/layouts/boilerplate") %>

<!-- MAP DATA -->
<script>
  const mapApi = "<%= process.env.MAPTILER_API_KEY %>";
  const listingData = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>

  <% const imageSrc = listing.image?.url || listing.image || ""; %>

  <div class="card col-6 offset-3 show-card">
    <img src="<%= imageSrc %>" class="card-img-top show-img">

    <div class="card-body">
      <p>Owned by: <i><%= listing.owner.username %></i></p>
      <p><%= listing.description %></p>
      <p>₹ <%= (listing.price || 0).toLocaleString("en-IN") %></p>
      <p><%= listing.location %></p>
      <p><%= listing.country %></p>
    </div>
  </div>
</div>

<br>

<!-- EDIT + DELETE -->
<% if (currUser && currUser._id.toString() === listing.owner._id.toString()) { %>
  <div class="col-8 offset-3 mb-3">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>

    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="display:inline;">
      <button class="btn btn-dark">Delete</button>
    </form>
  </div>
<% } %>

<!-- REVIEWS -->
<div class="col-8 offset-3 mb-3">

  <% if (currUser) { %>
    <hr>
    <h4>Leave a Review</h4>

    <form action="/listings/<%= listing._id %>/reviews" method="POST">

      <label>Rating</label>
      <fieldset class="starability-slot">
        <input type="radio" name="review[rating]" value="1" checked />
        <input type="radio" name="review[rating]" value="2" />
        <input type="radio" name="review[rating]" value="3" />
        <input type="radio" name="review[rating]" value="4" />
        <input type="radio" name="review[rating]" value="5" />
      </fieldset>

      <div class="mt-3">
        <label>Comment</label>
        <textarea name="review[comment]" class="form-control" required></textarea>
      </div>

      <button class="btn btn-outline-dark mt-2">Submit</button>
    </form>
    <hr>
  <% } %>

  <% if (listing.reviews.length > 0) { %>
    <h4>All Reviews</h4>

    <div class="row">
      <% for (let review of listing.reviews) { %>
        <div class="card col-5 ms-3 mb-3">
          <div class="card-body">
            <h5>@<%= review.author.username %></h5>
            <p>Rating: <%= review.rating %></p>
            <p><%= review.comment %></p>

            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-dark">Delete</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

</div>

<!-- MAP -->
<div class="col-8 offset-3">
  <h3>Where you'll be</h3>
  <div id="map" style="height: 400px;"></div>
</div>

<!-- MAPTILER -->
<script src="https://cdn.maptiler.com/maptiler-sdk-js/v2.0.0/maptiler-sdk.umd.min.js"></script>
<link href="https://cdn.maptiler.com/maptiler-sdk-js/v2.0.0/maptiler-sdk.css" rel="stylesheet" />

<script>
  if (listingData.geometry && listingData.geometry.coordinates) {

    maptilersdk.config.apiKey = mapApi;

    const coordinates = listingData.geometry.coordinates;

    const map = new maptilersdk.Map({
      container: 'map',
      style: maptilersdk.MapStyle.STREETS,
      center: coordinates,
      zoom: 10
    });

    new maptilersdk.Marker()
      .setLngLat(coordinates)
      .addTo(map);

  } else {
    document.getElementById("map").innerHTML = "<p>Location not available</p>";
  }
</script>